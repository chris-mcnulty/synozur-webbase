{
  "_comment": [
    "Mobile-profile Lighthouse CI assertions (task #248).",
    "Mobile Core Web Vitals budgets (LCP/TBT/CLS) are materially stricter",
    "than desktop, and most real traffic to the marketing site is mobile.",
    "On first rollout every assertion is at 'warn' so we can land the gate",
    "without an immediate red CI; flip clean routes to 'error' once mobile",
    "scores are stable. Desktop assertions live in lighthouserc.json and",
    "remain the merge-blocking gate today."
  ],
  "ci": {
    "collect": {
      "url": [
        "http://localhost:5000/",
        "http://localhost:5000/about",
        "http://localhost:5000/services",
        "http://localhost:5000/insights",
        "http://localhost:5000/contact",
        "http://localhost:5000/library",
        "http://localhost:5000/applications"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "mobile",
        "skipAudits": [
          "uses-http2",
          "is-on-https"
        ]
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^http://localhost:5000/(|about|services|insights|contact)$",
          "assertions": {
            "categories:performance": ["warn", { "minScore": 0.8 }],
            "categories:accessibility": ["warn", { "minScore": 0.9 }],
            "categories:best-practices": ["warn", { "minScore": 0.9 }],
            "categories:seo": ["warn", { "minScore": 0.9 }],
            "largest-contentful-paint": ["warn", { "maxNumericValue": 2500 }],
            "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.1 }],
            "total-blocking-time": ["warn", { "maxNumericValue": 300 }]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:5000/(library|applications)$",
          "assertions": {
            "categories:performance": ["warn", { "minScore": 0.8 }],
            "categories:accessibility": ["warn", { "minScore": 0.9 }],
            "categories:best-practices": ["warn", { "minScore": 0.9 }],
            "categories:seo": ["warn", { "minScore": 0.9 }],
            "largest-contentful-paint": ["warn", { "maxNumericValue": 2500 }],
            "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.1 }],
            "total-blocking-time": ["warn", { "maxNumericValue": 300 }]
          }
        }
      ]
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
