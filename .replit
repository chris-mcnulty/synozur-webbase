modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test:og-images"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test:og-static-pages"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test:og-dynamic"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "mockup-sandbox-typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck:synozur"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck:galaxy"

[[workflows.workflow]]
name = "test:og-images"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test:og-images"

[[workflows.workflow]]
name = "test:og-static-pages"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test:og-static-pages"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "test:og-dynamic"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test:og-dynamic"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "typecheck"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run typecheck:ci"

[[workflows.workflow]]
name = "mockup-sandbox-typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/mockup-sandbox run typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "typecheck:synozur"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/synozur run typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "typecheck:galaxy"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/galaxy run typecheck"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["hubspot:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
ADMIN_EMAILS = "chris.mcnulty@synozur.com,admin@synozur.com,michelle.caldwell@synozur.com"
SITE_URL = "https://www.synozur.com"

[userenv.development]
STORAGE_BACKEND = "spe"

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3001

[[ports]]
localPort = 20131
externalPort = 3000

[[ports]]
localPort = 20132
externalPort = 3003

[[ports]]
localPort = 23665
externalPort = 3002

[[ports]]
localPort = 23666
externalPort = 4200
