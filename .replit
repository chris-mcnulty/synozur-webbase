modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test:og-images"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test:og-static-pages"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test:og-dynamic"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "mockup-sandbox-typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck:synozur"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck:galaxy"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck-api-server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test-traffic-bot"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test-social-bot-renderer"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test-bots"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test:image-attrs"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test-proof-links"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test:seo-audit-config"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test:experiments-bucket"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test:event-jsonld"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test:polaris-meta-desc-guard"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test:video-meta-desc-guard"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test:insight-meta-desc-guard"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test:event-meta-desc-guard"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test:workshop-meta-desc-guard"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test:collateral-meta-desc-guard"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test:forms-hutk"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test:hubspot-hutk"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test:attribution"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test:booking-share-image-api"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test:booking-share-image-ui"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test:page-readability"

[[workflows.workflow]]
name = "test:og-images"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test:og-images"

[[workflows.workflow]]
name = "test:og-static-pages"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test:og-static-pages"

[workflows.workflow.metadata]
isValidation = true

