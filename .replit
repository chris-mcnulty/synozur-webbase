[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["hubspot:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
ADMIN_EMAILS = "chris.mcnulty@synozur.com,admin@synozur.com,michelle.caldwell@synozur.com"
SITE_URL = "https://www.synozur.com"

[userenv.development]
STORAGE_BACKEND = "spe"

[userenv.production]
HUBSPOT_PORTAL_ID = "49076134"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 20131
externalPort = 80

[[ports]]
localPort = 23665
externalPort = 3000
