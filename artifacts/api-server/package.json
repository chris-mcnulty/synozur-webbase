    "test:portal-documents": "node --import tsx --test src/routes/portalDocuments.test.ts",
    "test:og-regenerate": "node --import tsx --test src/routes/og.regenerate.test.ts",
    "test:landing-pages-schema": "node --import tsx --test src/routes/landingPages.schema.test.ts",
    "test:search-synonyms": "node --import tsx --test src/routes/search.synonyms.test.ts",
    "test:seo-coverage": "node --import tsx --test src/lib/seoCoverage.test.ts",
