    "test:email": "node --import tsx --test src/lib/email.test.ts",
    "test:polaris-bulk-sync": "node --import tsx --test src/routes/polaris.bulkSync.test.ts",
    "test:auth-rate-limit": "node --import tsx --test src/routes/auth.rateLimit.test.ts",
    "test:traffic-ingest": "node --import tsx --test src/routes/traffic.ingest.test.ts",
    "test:traffic-import": "node --import tsx --test src/routes/cms/trafficImport.test.ts",
    "test:insights-gone": "node --import tsx --test src/routes/insights.gone.test.ts",
