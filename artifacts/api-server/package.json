{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc --build ../../tsconfig.json && tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/scripts/runMigrations.ts",
    "ingest:services": "tsx src/scripts/ingestServices.ts",
    "seed:events": "tsx src/scripts/seedEvents.ts",
    "seed:workshops": "tsx src/scripts/seedWorkshops.ts",
    "seed:case-studies": "tsx src/scripts/seedCaseStudies.ts",
    "seed:applications": "tsx src/scripts/seedApplications.ts",
    "seed:about-content": "tsx src/scripts/seedAboutContent.ts",
    "seed:solution-enrichments": "tsx src/scripts/seedSolutionEnrichments.ts",
    "seed:bookings": "tsx src/scripts/seedBookings.ts",
    "seed:m365-solution": "tsx src/scripts/seedM365Solution.ts",
    "seed:m365": "tsx src/scripts/seedM365Full.ts",
    "fix:polaris-collateral": "tsx src/scripts/fixPolarisCollateral.ts",
    "backfill:media-categories": "tsx src/scripts/backfillMediaCategories.ts",
    "backfill:post-body-html": "tsx src/scripts/backfillPostBodyHtml.ts",
    "backfill:image-content-types": "tsx src/scripts/backfillImageContentTypes.ts",
