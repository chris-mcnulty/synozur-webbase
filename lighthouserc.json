{
  "_comment": [
    "Lighthouse CI assertions for the public marketing site.",
    "Two assertMatrix entries:",
    "  1. Clean routes (/, /about, /services, /insights, /contact) gate at",
    "     'error' for performance/accessibility/best-practices/SEO",
    "     categories AND for the LCP/CLS/TBT metric budgets, so any",
    "     regression below the configured budgets blocks PR merge.",
    "  2. Noisy routes (/library, /applications) stay at 'warn' until",
    "     their perf/SEO debt is cleaned up. Tracked as follow-up #247",
    "     (parent task #233, which shipped #156 / launch-readiness L10)",
    "     — flip those entries to 'error' once both routes pass cleanly.",
    "     Do NOT add new routes here at 'warn' without a tracked cleanup",
    "     task."
  ],
  "ci": {
    "collect": {
      "url": [
        "http://localhost:5000/",
        "http://localhost:5000/about",
        "http://localhost:5000/services",
        "http://localhost:5000/insights",
        "http://localhost:5000/contact",
        "http://localhost:5000/library",
        "http://localhost:5000/applications"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "skipAudits": [
          "uses-http2",
          "is-on-https"
        ]
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^http://localhost:5000/(|about|services|insights|contact)$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.85 }],
            "categories:accessibility": ["error", { "minScore": 0.9 }],
            "categories:best-practices": ["error", { "minScore": 0.9 }],
            "categories:seo": ["error", { "minScore": 0.9 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
            "total-blocking-time": ["error", { "maxNumericValue": 300 }]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:5000/(library|applications)$",
          "assertions": {
            "categories:performance": ["warn", { "minScore": 0.85 }],
            "categories:accessibility": ["warn", { "minScore": 0.9 }],
            "categories:best-practices": ["warn", { "minScore": 0.9 }],
            "categories:seo": ["warn", { "minScore": 0.9 }],
            "largest-contentful-paint": ["warn", { "maxNumericValue": 2500 }],
            "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.1 }],
            "total-blocking-time": ["warn", { "maxNumericValue": 300 }]
          }
        }
      ]
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
